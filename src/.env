# Copy this file to .env and fill in your credentials.
APP_ID=
SDK_KEY=

# Measurement window in milliseconds (default: 30000)
MEASUREMENT_DURATION=30000

# RTSP stream URL (required for rtsp_sample.py)
RTSP_URL=rtsp://<user>:<password>@<host>:554/h264/ch1/main/av_stream

# RTSP stream FPS (should be <= actual stream FPS, default: 25)
RTSP_FPS=25
